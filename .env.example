# Copy to .env.local and fill in. Nothing here is a real value.
#
# Production sets these in Vercel, not from a file. The two NEXT_PUBLIC_ ones
# reach the browser by design; everything else is server-only.

# --- Required: data ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Required: sign-in (NextAuth v5) ---
# The AUTH_ prefix is not interchangeable with the older NEXTAUTH_ names; v5
# reads these. Only the addresses in ALLOWED_EMAILS (src/lib/auth.ts) can write.
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
AUTH_SECRET=generate-with-openssl-rand-base64-32

# --- Server-only ---
# Billing falls back to the anon key without this, and the anon key is
# read-only under RLS, so writes need the real thing.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# /api/cron/bill returns 500 until this is set, then requires it as a bearer
# token. Vercel Cron sends it automatically.
CRON_SECRET=any-long-random-string

# --- Optional ---
# Mid-market is a reference, not a price anyone transacts at. Default 1.01.
# Set it from a real statement rather than trusting the default.
FX_MARKUP=1.01
# Unset, /api/charges/today is public. Set it to require
# `Authorization: Bearer <token>` — no code change needed.
READONLY_TOKEN=
# --- Daily job (/api/cron/daily, Vercel Cron) ---
# It keeps the database awake whatever is set here. The unpaid alert mails only
# once both SMTP values are set; until then each run just reports who is over.
# The same names the GitHub workflow used, so the values copy across as they are.
# For Gmail, SMTP_PASSWORD is an app password, not the account's own.
SMTP_USERNAME=
SMTP_PASSWORD=
# Who gets the alert. Default: SMTP_USERNAME.
ALERT_TO=
# Mail about anyone owing more than this, in CNY. Default 500.
UNPAID_THRESHOLD_CNY=500
# Optional. Defaults: smtp.gmail.com, 465, and SMTP_USERNAME as the sender.
SMTP_SERVER=
SMTP_PORT=
MAIL_FROM=

# Lets an agent or a script act as the finance owner on /api/finance/* with
# `Authorization: Bearer <token>`: reads and writes, finance only. Unset, or
# shorter than 32 characters, and only the owner's Google sign-in gets in.
# Generate with `openssl rand -hex 32`. Rotate by replacing it and redeploying.
FINANCE_API_TOKEN=
