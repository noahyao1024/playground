# Copy to .env.local and fill in. Nothing here is a real value.
#
# Production sets these in Vercel, not from a file. The two NEXT_PUBLIC_ ones
# reach the browser by design; everything else is server-only.

# --- Required: data ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Required: sign-in (NextAuth v5) ---
# The AUTH_ prefix is not interchangeable with the older NEXTAUTH_ names; v5
# reads these. Only the addresses in ALLOWED_EMAILS (src/lib/auth.ts) can write.
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
AUTH_SECRET=generate-with-openssl-rand-base64-32

# --- Server-only ---
# Billing falls back to the anon key without this, and the anon key is
# read-only under RLS, so writes need the real thing.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The cron routes (/api/cron/*) require it as a bearer token, and answer 500
# to anything else until it is set. Vercel Cron sends it automatically. The
# Daily jobs workflow needs no copy: the site knows it by its GitHub OIDC token.
CRON_SECRET=any-long-random-string

# --- Optional ---
# Mid-market is a reference, not a price anyone transacts at. Default 1.01.
# Set it from a real statement rather than trusting the default.
FX_MARKUP=1.01
# Unset, /api/charges/today is public. Set it to require
# `Authorization: Bearer <token>` — no code change needed.
READONLY_TOKEN=
# The daily check (/api/cron/daily) reports anyone owing more than this, in
# CNY. Default 500. The mail itself goes out from the Daily jobs workflow,
# through the SMTP account held as GitHub secrets, so no mail settings live here.
UNPAID_THRESHOLD_CNY=500

# Optional. Lets an agent or a script act as the finance owner on /api/finance/*
# with `Authorization: Bearer <token>`: reads and writes, finance only. Tokens
# are better made on the page (/finance -> API access), shown once and revocable
# there with no redeploy; this is the same thing set by hand. Unset, or shorter
# than 32 characters, and it lets nobody in. `openssl rand -hex 32` makes one.
FINANCE_API_TOKEN=
